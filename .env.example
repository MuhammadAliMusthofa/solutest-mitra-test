# Salin ke .env.local untuk pengembangan lokal: cp .env.example .env.local

# Base URL backend be-solutest-mitra (tanpa trailing slash).
# Lokal: http://localhost:3100/api/v1 · staging: https://be-solutest-mitra-staging-339930537017.asia-southeast2.run.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3100/api/v1

# true  → analitik & progres memakai data simulasi (demo).
# false → analitik dari backend. Endpoint lain selalu ke NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_MOCK=false

# Nama aplikasi (fallback bila branding mitra belum dimuat).
NEXT_PUBLIC_APP_NAME=Solutest Mitra
